<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiRemindMe.Views.AddNotification"
            xmlns:vm="clr-namespace:MauiRemindMe.ViewsModels"
             x:DataType="vm:AddNotificationVM"
             Title="Add Notification ">
    

    <ScrollView BackgroundColor="#F0F8FF">
        <!-- רקע תכלת בהיר מאוד לכל הדף -->
        <VerticalStackLayout Spacing="20" Padding="25">

            <!-- כותרת ראשית -->
            <Label 
            Text="Add Notification"
            FontSize="28"
            TextColor="#006400" 
            FontAttributes="Bold"
            HorizontalOptions="Center"
            Margin="0,10,0,10" />

            <!-- כרטיס המכיל את הטופס -->
            <Border BackgroundColor="White" 
              
               Padding="20">

                <VerticalStackLayout Spacing="15">

                    <!-- שדה תיאור -->
                    <Label Text="Event Description" TextColor="#006400" FontAttributes="Bold" />
                    <Border BackgroundColor="#F9FFFF" Padding="5,0">
                        <Entry Text="{Binding Description}" 
                           Placeholder="What's on your mind?"
                           PlaceholderColor="Gray"
                           TextColor="Black"
                           HeightRequest="45" />
                    </Border>

                    <!-- בחירת סוג (Picker) -->
                    <Label Text="Notification Type" TextColor="#006400" FontAttributes="Bold" />
                    <Border BackgroundColor="#F9FFFF" Padding="5,0">
                        <Picker x:Name="notification"
                            Title="Select type..."
                            SelectedItem="{Binding StatusV}"
                            TextColor="Black">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Task</x:String>
                                    <x:String>Event</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </Border>

                    <!-- תצוגת הבחירה (לייבל תחתון) -->
                    <Label x:Name="status" 
                       Text="{Binding Source={x:Reference notification}, Path=SelectedItem}"
                       TextColor="#006400"
                       FontSize="12"
                       HorizontalOptions="End" />

                    <!-- בחירת תאריך ושעה -->
                    <Label Text="Date and Time" TextColor="#006400" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <DatePicker Grid.Column="0"
                                x:Name="myDatePicker" 
                                Date="{Binding SelectedDate, Mode=TwoWay}" Format="dd/MM/yyyy"
                                TextColor="Black"
                                BackgroundColor="#F9FFFF" />

                        <TimePicker Grid.Column="1"
                                    x:Name="myTimePicker" 
                                   Time="{Binding TimeNe, Mode=TwoWay}" Format="HH:mm" 
                                TextColor="Black"
                                BackgroundColor="#F9FFFF" />
                    </Grid>

                    <!-- כפתור הוספה -->
                    <Button Text="ADD NOTIFICATION" 
                        Command="{Binding SaveNoteCommand}"
                        BackgroundColor="#006400"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="25"
                        HeightRequest="55"
                        Margin="0,15,0,0" />

                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>