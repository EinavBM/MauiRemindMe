<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiRemindMe.Views.RegisterListPage"
             xmlns:models="clr-namespace:MauiRemindMe.Models"
             xmlns:vm="clr-namespace:MauiRemindMe.ViewsModels"
             x:DataType="vm:RegisterListVM"
             Title="RegisterListPage">
    <ScrollView >
        <VerticalStackLayout>

            <!--כותרת העמוד-->
            <Label Text="Registered Users" 
           FontSize="24" 
           TextColor="#006400" 
           FontAttributes="Bold" 
           HorizontalOptions="Center" 
           Margin="0,0,0,10"/>


            <CollectionView ItemsSource="{Binding Userlist}">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:MyUser">
                        <SwipeView>
                            <SwipeView.LeftItems>
                                <SwipeItems Mode="Reveal">
                                    <SwipeItem Command="{Binding DeleteAppUserCommand, Source={x:RelativeSource AncestorType={x:Type vm:RegisterListVM}}}"
                                       CommandParameter="{Binding Id}"
                                       Text="Delete"
                                       BackgroundColor="#FF4C4C" />

                                    <SwipeItem Command="{Binding ShowUserCommand, Source={x:RelativeSource AncestorType={x:Type vm:RegisterListVM}}}"
                                       CommandParameter="{Binding Id}"
                                       Text="Edit"
                                       BackgroundColor="#006400" />
                                </SwipeItems>
                            </SwipeView.LeftItems>

                            <!--עיצוב כל שורה ככרטיס (Border)-->
                            <Border Stroke="#ADD8E6"
                            StrokeThickness="1"
                            BackgroundColor="White"
                            Padding="15"
                            Margin="0,5"
                            HorizontalOptions="Fill">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>

                                <!--סידור הנתונים בטבלה-->
                                <Grid ColumnDefinitions="*, 1.5*, *" ColumnSpacing="10">
                                    <Label Grid.Column="0" 
                                   Text="{Binding Name}" 
                                   TextColor="#006400" 
                                   FontAttributes="Bold" 
                                   VerticalOptions="Center" />

                                    <Label Grid.Column="1" 
                                   Text="{Binding Email}" 
                                   TextColor="Gray" 
                                   FontSize="13"
                                   VerticalOptions="Center" />

                                    <Label Grid.Column="2" 
                                   Text="{Binding Password}" 
                                   TextColor="DimGray" 
                                   FontSize="13"
                                   HorizontalOptions="End" />
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!--כפתור רענון/טעינה בתחתית-->
            <Button Text="Refresh List"
            Command="{Binding LoadDataCommand}"
            BackgroundColor="#006400"
            TextColor="White"
            CornerRadius="20"
            HeightRequest="50"
            FontAttributes="Bold"
            Margin="0,10,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>