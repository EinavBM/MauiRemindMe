<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:vm="clr-namespace:MauiRemindMe.ViewsModels"
             x:Class="MauiRemindMe.Views.AddAndEditNotification"
             x:DataType="vm:AddAndEditNotificationVM"
             Title="AddAndEditNotification">
    

    <ScrollView BackgroundColor="#F0F8FF">
        <VerticalStackLayout Spacing="20" Padding="25" VerticalOptions="Center">

            <!-- כותרת העמוד -->
            <Label Text="Edit Notification"
               FontSize="26"
               TextColor="#006400" 
               FontAttributes="Bold"
               HorizontalOptions="Center" />

            <!-- הודעת שגיאה (אם יש) -->
            <Label Text="{Binding FailError}" 
               TextColor="Red" 
               HorizontalOptions="Center"
               IsVisible="{Binding FailError, Converter={StaticResource StringNotEmptyConverter}}" />

            <!-- כרטיס העריכה -->
            <Border Stroke="#ADD8E6"
                BackgroundColor="White"
                Padding="20"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="15">

                    <!-- עריכת סטטוס/סוג -->
                    <Label Text="Status" TextColor="#006400" FontAttributes="Bold" />
                    <Border Stroke="#ADD8E6" BackgroundColor="#F9FFFF" Padding="10,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Entry Text="{Binding ItemReceived.Status}" 
                           Placeholder="e.g. Task, Event" 
                           TextColor="Black" />
                    </Border>

                    <!-- עריכת תוכן/מידע -->
                    <Label Text="Description" TextColor="#006400" FontAttributes="Bold" />
                    <Border Stroke="#ADD8E6" BackgroundColor="#F9FFFF" Padding="10,0">

                        <Entry Text="{Binding ItemReceived.Info}" 
                           Placeholder="What needs to be done?" 
                           TextColor="Black" />
                    </Border>

                    <!-- עריכת תאריך ושעה (זה לצד זה) -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Text="Date" TextColor="#006400" FontAttributes="Bold" />
                            <!-- שימוש ב-DatePicker עבור DateN -->
                            <DatePicker Date="{Binding ItemReceived.DateN}" 
                                    TextColor="Black" 
                                    BackgroundColor="#F9FFFF" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="Time" TextColor="#006400" FontAttributes="Bold" />
                            <!-- שימוש ב-TimePicker עבור TimeN -->
                            <TimePicker Time="{Binding ItemReceived.Time}" 
                                    TextColor="Black" 
                                    BackgroundColor="#F9FFFF" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- כפתורי פעולה -->
                    <VerticalStackLayout Spacing="10" Margin="0,15,0,0">
                        <Button Text="SAVE CHANGES" 
                            Command="{Binding SaveAndUpdateCommand}"
                            BackgroundColor="#006400"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="25"
                            HeightRequest="55" />

                        <Button Text="Cancel" 
                            Command="{Binding GoBackCommand}" 
                            BackgroundColor="Transparent"
                            TextColor="#006400" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>