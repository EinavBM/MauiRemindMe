<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiRemindMe.Views.SearchDate"
             xmlns:models="clr-namespace:MauiRemindMe.Models"
             xmlns:vm="clr-namespace:MauiRemindMe.ViewsModels"
             x:DataType="vm:SearchDate2"
             Title="SearchDate">
    <!--עדיין בעבודה-->

    <StackLayout Spacing="20" Padding="20">

        <!--כותרת-->
        <Label Text="חיפוש מטלות" 
           FontSize="24" 
           TextColor="#006400" 
           FontAttributes="Bold" 
           HorizontalOptions="Center" />

        <!--Grid מאפשר לנעול את הכפתור בתחתית המסך-->
        <Grid RowDefinitions="Auto, *, *, Auto" Padding="20" RowSpacing="15">

            <!--1. אזור בחירת התאריך (בראש המסך)-->
            <VerticalStackLayout Grid.Row="0" Spacing="10">

                <Border Stroke="#ADD8E6" BackgroundColor="White" Padding="10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Select Date to View Tasks:" TextColor="Gray" FontSize="14" />
                        <!--שינוי התאריך מפעיל אוטומטית את הסינון ב-VM בזכות ה-Binding-->
                        <DatePicker Date="{Binding SelectedSearchDate}" 
                                TextColor="Black" 
                                HorizontalOptions="Fill" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!--2. תוצאות החיפוש - רשימת המשימות של אותו היום-->
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="10">

                    <!--כותרת משנה דינמית שמראה כמה משימות נמצאו-->
                    <Label Text="{Binding ResultsCountText}" 
                       TextColor="#006400" 
                       FontAttributes="Bold" 
                       FontSize="16" 
                       Margin="5,5,0,0"/>

                    <!--רשימת המשימות המסוננות-->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding FilteredNotifications}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:NotificationM">
                                <Border Stroke="#ADD8E6" BackgroundColor="White" Padding="15" Margin="0,4">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>

                                    <Grid ColumnDefinitions="1.2*, 2*, *" ColumnSpacing="10">
                                        <!--סוג (Status)-->
                                        <Label Grid.Column="0" Text="{Binding Status}" TextColor="#006400" FontAttributes="Bold" VerticalOptions="Center"/>
                                        <!--תיאור (Info)-->
                                        <Label Grid.Column="1" Text="{Binding Info}" TextColor="Black" LineBreakMode="TailTruncation" VerticalOptions="Center"/>
                                        <!--שעה (TimeN)-->
                                        <Label Grid.Column="2" Text="{Binding TimeN}" TextColor="DimGray" HorizontalOptions="End" VerticalOptions="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>


            <!--כפתור חיפוש-->
            <!--Clicked="OnSearchClicked"-->

            <Button Grid.Row="2" 
                Text="Search date" 
    BackgroundColor="#006400" 
    TextColor="White"
    CornerRadius="25"
    HeightRequest="50"
    FontAttributes="Bold"
    Margin="0,10,0,0" />

            <!--3. כפתור ניווט קבוע בתחתית להוספת תזכורת חדשה-->
            <Button Grid.Row="3" 
                Text="+ CREATE NEW REMINDER"
                Command="{Binding GoToAddNotificationCommand}"
                BackgroundColor="#006400"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="25"
                HeightRequest="55"
                Margin="0,10,0,10" />

        </Grid>
    </StackLayout>


</ContentPage>